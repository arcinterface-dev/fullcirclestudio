{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "fullcirclestudio",
    "main": ".open-next/worker.js", // This tells Cloudflare where the code is
    "compatibility_date": "2024-11-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets", // This replaces the UI field
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}